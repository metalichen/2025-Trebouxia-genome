#Snakefile for mapping metatranscriptomic lichen data to the combine set of transcripts

import pandas as pd
import re


SAMPLES=["XBE1","XBC1","XBE2","XBC2","XSE2","XSC2","XTE2","XTC2"]

rule all:
    input:
    	"analysis_and_temp_files/09_transcriptomics/kallisto_palign_report.txt",
    	"analysis_and_temp_files/09_transcriptomics/kallisto_report.txt"


rule get_reads:
    output: 
        fq1="analysis_and_temp_files/09_transcriptomics/{sample}_algal.1.fastq.gz",
        fq2="analysis_and_temp_files/09_transcriptomics/{sample}_algal.2.fastq.gz"
    params:
        mem = "30G",
        queue="tsl-short"
    threads: 20
    shell: "code/extract_algal_reads.sh ../03_transcriptomic_analysis/analysis_and_temp_files/06_meta_mapping/{wildcards.sample}_kallisto/pseudoalignments.bam analysis_and_temp_files/09_transcriptomics/Trebouxia_loci.txt {wildcards.sample} {output.fq1} 19"    
        
        
rule kallisto:
    input: 
    	fq1="analysis_and_temp_files/09_transcriptomics/{sample}_algal.1.fastq.gz",
    	fq2="analysis_and_temp_files/09_transcriptomics/{sample}_algal.2.fastq.gz"
    output: 
        abund="analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/abundance.tsv",
        report="analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/run_info.json"
    params:
        mem = "30G",
        queue="tsl-short"
    threads: 20
    shell: "bash code/kallisto.sh analysis_and_temp_files/09_transcriptomics/Trebouxia_sp._A48.idx 20 100 {input.fq1} {input.fq2} {output.abund}"    
        
        
