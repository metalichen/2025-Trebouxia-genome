rule kallisto_palign_report:
    '''creates a single report file of p_unique stat from each kallisto report'''
    input: 
        expand("analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/p_unique.txt",sample=SAMPLES)
    output:	"analysis_and_temp_files/09_transcriptomics/kallisto_palign_report.txt"
    params:
        mem = "1G",
        queue="tsl-short"   
    threads: 1
    shell:
        "cat {input} > {output}"


rule add_sample_id:
    '''adds a column to the kallisto report with a sample id'''
    input: "analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/abundance.tsv"
    output: "analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/abundance_add_id.tsv"
    params:
        mem = "1G",
        queue="tsl-short"   
    threads: 1
    shell:
        """awk 'BEGIN {{ FS = OFS = "\t" }} {{ $(NF+1) = "{wildcards.sample}"; print $0 }}' {input} | awk 'NR!=1 {{print}}' > {output}"""

rule combine_reports:
    input: 
        expand("analysis_and_temp_files/09_transcriptomics/{sample}_kallisto/abundance_add_id.tsv",sample=SAMPLES)
    output:	"analysis_and_temp_files/09_transcriptomics/kallisto_report.txt"
    params:
        mem = "1G",
        queue="tsl-short"   
    threads: 1
    shell:
        "cat {input} > {output}"
       

        